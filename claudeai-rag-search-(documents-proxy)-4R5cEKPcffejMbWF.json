{"updatedAt":"2026-06-25T12:36:14.801Z","createdAt":"2026-06-25T12:17:39.869Z","id":"4R5cEKPcffejMbWF","name":"ClaudeAi RAG Search (Documents Proxy)","active":false,"isArchived":true,"nodes":[{"parameters":{"httpMethod":"GET","path":"claude-ai-rag-search","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2,"position":[0,300],"id":"rag-webhook-01","name":"Webhook","webhookId":"rag-search-9f2a4c1b8e7dclaudeai01"},{"parameters":{"jsCode":"const q = $input.first().json.query?.q || $input.first().json.query?.query || '';\nconst count = parseInt($input.first().json.query?.count || '8');\nconst threshold = parseFloat($input.first().json.query?.threshold || '0.5');\nconst file_id = $input.first().json.query?.file_id || null;\nif (!q || q.trim().length === 0) { return [{ json: { error: 'Missing query. Use ?q=your+search', results: [] } }]; }\nreturn [{ json: { query: q.trim(), count, threshold, file_id } }];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[210,300],"id":"rag-parse-01","name":"Parse Query Params"},{"parameters":{"method":"POST","url":"https://api.openai.com/v1/embeddings","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"Bearer ***REDACTED***"},{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({\"model\": \"text-embedding-3-small\", \"input\": $json.query}) }}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[420,300],"id":"rag-openai-01","name":"OpenAI Embedding","retryOnFail":true,"maxTries":2,"waitBetweenTries":3000},{"parameters":{"jsCode":"const embedding = $input.first().json.data[0].embedding;\nconst params = $('Parse Query Params').first().json;\nconst body = { query_embedding: JSON.stringify(embedding), match_count: params.count, filter: params.file_id ? { file_id: params.file_id } : {} };\nreturn [{ json: { rpcBody: JSON.stringify(body) } }];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[630,300],"id":"rag-prep-01","name":"Prepare RPC Body"},{"parameters":{"method":"POST","url":"https://apfngqcnjdfinqwefzcs.supabase.co/rest/v1/rpc/match_documents","sendHeaders":true,"headerParameters":{"parameters":[{"name":"apikey","value":"***REDACTED***"},{"name":"Authorization","value":"Bearer ***REDACTED***"},{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ $json.rpcBody }}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[840,300],"id":"rag-supa-01","name":"Supabase Match Documents"},{"parameters":{"jsCode":"const params = $('Parse Query Params').first().json;\nconst threshold = params.threshold || 0.5;\nconst results = $input.all().map(item => {\n  const d = item.json; const md = d.metadata || {};\n  return { content: d.content || '', file_id: md.file_id || '', lines: (md.loc && md.loc.lines) || null, similarity: d.similarity ? Math.round(d.similarity*100)/100 : 0 };\n}).filter(r => r.similarity >= threshold);\nreturn [{ json: { count: results.length, query: params.query, file_id: params.file_id || null, results } }];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1050,300],"id":"rag-fmt-01","name":"Format Results"},{"parameters":{"respondWith":"json","responseBody":"={{ JSON.stringify($json) }}","options":{}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1,"position":[1260,300],"id":"rag-respond-01","name":"Respond to Webhook"}],"connections":{"Webhook":{"main":[[{"node":"Parse Query Params","type":"main","index":0}]]},"Parse Query Params":{"main":[[{"node":"OpenAI Embedding","type":"main","index":0}]]},"OpenAI Embedding":{"main":[[{"node":"Prepare RPC Body","type":"main","index":0}]]},"Prepare RPC Body":{"main":[[{"node":"Supabase Match Documents","type":"main","index":0}]]},"Supabase Match Documents":{"main":[[{"node":"Format Results","type":"main","index":0}]]},"Format Results":{"main":[[{"node":"Respond to Webhook","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","errorWorkflow":"heQ08w9HPkxGpNDu","callerPolicy":"workflowsFromSameOwner","availableInMCP":false},"staticData":null,"meta":null,"pinData":null,"versionId":"342c40e0-72e0-4bb6-a4be-107709068b10","activeVersionId":null,"triggerCount":0,"shared":[{"updatedAt":"2026-06-25T12:17:39.869Z","createdAt":"2026-06-25T12:17:39.869Z","role":"workflow:owner","workflowId":"4R5cEKPcffejMbWF","projectId":"NLlHufgAcMM6m1Lv"}],"activeVersion":null,"tags":[]}